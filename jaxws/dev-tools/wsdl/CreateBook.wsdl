<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions
        xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
        xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
        xmlns:xsd="http://www.w3.org/2001/XMLSchema"
        xmlns:tns="http://bookservice.com/createbook/wsdl/v1"
        xmlns:bk="http://bookservice.com/book/v1"
        xmlns:cmn="http://bookservice.com/common/v1"
        name="CreateBookService"
        targetNamespace="http://bookservice.com/createbook/wsdl/v1">

    <!-- ══ SECTION 1: Types — import external XSD files ══════════════════════ -->
    <wsdl:types>
        <xsd:schema>
            <xsd:import
                    namespace="http://bookservice.com/book/v1"
                    schemaLocation="book.xsd"/>
            <xsd:import
                    namespace="http://bookservice.com/common/v1"
                    schemaLocation="common.xsd"/>
        </xsd:schema>
    </wsdl:types>

    <!-- ══ SECTION 2: Messages ═══════════════════════════════════════════════ -->
    <wsdl:message name="CreateBookRequest">
        <wsdl:part element="bk:CreateBookInput" name="CreateBookInput"/>
    </wsdl:message>

    <wsdl:message name="CreateBookResponse">
        <wsdl:part element="bk:CreateBookOutput" name="CreateBookOutput"/>
    </wsdl:message>

    <!-- Same WsException fault structure as GetBook — defined once in common.xsd -->
    <wsdl:message name="WsException">
        <wsdl:part name="WsFault" element="cmn:WsFault"/>
    </wsdl:message>

    <!-- ══ SECTION 3: PortType ═══════════════════════════════════════════════ -->
    <!-- name="CreateBookPortType" → Java interface: CreateBookPortType.java -->
    <wsdl:portType name="CreateBookPortType">
        <wsdl:operation name="CreateBook">
            <wsdl:input  message="tns:CreateBookRequest"  name="CreateBookRequest"/>
            <wsdl:output message="tns:CreateBookResponse" name="CreateBookResponse"/>
            <wsdl:fault  message="tns:WsException"        name="WsException"/>
        </wsdl:operation>
    </wsdl:portType>

    <!-- ══ SECTION 4: Binding ════════════════════════════════════════════════ -->
    <wsdl:binding name="CreateBookBinding" type="tns:CreateBookPortType">
        <soap:binding
                style="document"
                transport="http://schemas.xmlsoap.org/soap/http"/>

        <wsdl:operation name="CreateBook">
            <soap:operation soapAction="CreateBook"/>

            <wsdl:input name="CreateBookRequest">
                <soap:body use="literal"/>
            </wsdl:input>

            <wsdl:output name="CreateBookResponse">
                <soap:body use="literal"/>
            </wsdl:output>

            <wsdl:fault name="WsException">
                <soap:fault name="WsException" use="literal"/>
            </wsdl:fault>
        </wsdl:operation>
    </wsdl:binding>

    <!-- ══ SECTION 5: Service ════════════════════════════════════════════════ -->
    <wsdl:service name="CreateBookService">
        <wsdl:port binding="tns:CreateBookBinding" name="CreateBookPort">
            <soap:address location="REPLACE_WITH_ACTUAL_URL"/>
        </wsdl:port>
    </wsdl:service>

</wsdl:definitions>
