<?xml version="1.0" encoding="UTF-8"?>
<!--
╔══════════════════════════════════════════════════════════════════════════════╗
║  handler-chain.xml — JAX-WS Handler Chain Configuration                      ║
╠══════════════════════════════════════════════════════════════════════════════╣
║  This file declares the handler(s) that intercept SOAP messages for each     ║
║  endpoint annotated with @HandlerChain(file = "/handler-chain.xml").         ║
║                                                                              ║
║  Both GetBookPortTypeImpl and CreateBookPortTypeImpl reference this file.    ║
║  So CredentialsHandler runs for EVERY operation in the service.              ║
║                                                                              ║
║  Handler execution order:                                                    ║
║    Inbound:   Handler1 → Handler2 → ... → Service Impl                       ║
║    Outbound:  Service Impl → ... → Handler2 → Handler1                       ║
║  (Outbound order is REVERSED — like a stack)                                 ║
║                                                                              ║
║  The file must be on the classpath root ("/handler-chain.xml").              ║
║  It lives in src/main/resources/ which Maven places on the classpath root.   ║
╚══════════════════════════════════════════════════════════════════════════════╝
-->
<handler-chains xmlns="http://java.sun.com/xml/ns/javaee">
    <handler-chain>
        <handler>
            <!--
            handler-class: fully qualified class name of the handler.
            This must implement javax.xml.ws.handler.soap.SOAPHandler
            or javax.xml.ws.handler.LogicalHandler.
            -->
            <handler-class>com.bookservice.ws.handler.CredentialsHandler</handler-class>
        </handler>

        <!--
        You can add more handlers here. For example:
        <handler>
            <handler-class>com.bookservice.ws.handler.AuditLoggingHandler</handler-class>
        </handler>
        -->
    </handler-chain>
</handler-chains>
