<?xml version="1.0" encoding="UTF-8"?>
<!--
╔══════════════════════════════════════════════════════════════════════════════╗
║  book-client pom.xml                                                         ║
╠══════════════════════════════════════════════════════════════════════════════╣
║  Two wsimport executions — one per WSDL file.                                ║
║  Each execution generates into a different Java package to avoid             ║
║  class name collisions (both WSDLs define WsException, WsCredentials, etc)   ║
╚══════════════════════════════════════════════════════════════════════════════╝
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>
    <groupId>com.bookservice</groupId>
    <artifactId>book-client</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <plugins>

            <!--
            ════════════════════════════════════════════════════════════════════
            JAX-WS Maven Plugin (official JAX-WS RI plugin)
            ════════════════════════════════════════════════════════════════════
            We could also use com.sun.xml.ws:jaxws-maven-plugin instead of the
            org.codehaus.mojo variant because the codehaus version 2.x bundles
            a broken wsimport that silently skips XSD imports, producing stubs
            without any of the type classes (GetBookInput, WsCredentials, etc.).

            The official RI plugin bundles its own wsimport from JAX-WS RI and
            correctly resolves relative schemaLocation paths co-located with
            the WSDL file.
            ════════════════════════════════════════════════════════════════════
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>jaxws-maven-plugin</artifactId>
                <version>2.6</version>
                <executions>

                    <!--
                    ════════════════════════════════════════════════════════════
                    Execution 1: Generate stubs from GetBook.wsdl
                    Package: com.bookservice.generated.getbook
                    ════════════════════════════════════════════════════════════
                    -->
                    <execution>
                        <id>wsimport-getbook</id>
                        <phase>generate-sources</phase>
                        <goals><goal>wsimport</goal></goals>
                        <configuration>
                            <wsdlFiles>
                                <wsdlFile>${project.basedir}/src/main/resources/wsdl/GetBook.wsdl</wsdlFile>
                            </wsdlFiles>
                            <wsdlLocation>wsdl/GetBook.wsdl</wsdlLocation>
                            <packageName>com.bookservice.generated.getbook</packageName>
                            <sourceDestDir>${project.build.directory}/generated-sources/wsimport</sourceDestDir>
                            <verbose>true</verbose>
                            <keep>true</keep>
                        </configuration>
                    </execution>

                    <!--
                    ════════════════════════════════════════════════════════════
                    Execution 2: Generate stubs from CreateBook.wsdl
                    Package: com.bookservice.generated.createbook
                    ════════════════════════════════════════════════════════════
                    Both packages will have BookType, WsCredentials, WsFault, etc.
                    Separate packages prevent class name collisions.
                    ════════════════════════════════════════════════════════════
                    -->
                    <execution>
                        <id>wsimport-createbook</id>
                        <phase>generate-sources</phase>
                        <goals><goal>wsimport</goal></goals>
                        <configuration>
                            <wsdlFiles>
                                <wsdlFile>${project.basedir}/src/main/resources/wsdl/CreateBook.wsdl</wsdlFile>
                            </wsdlFiles>
                            <wsdlLocation>wsdl/CreateBook.wsdl</wsdlLocation>
                            <packageName>com.bookservice.generated.createbook</packageName>
                            <sourceDestDir>${project.build.directory}/generated-sources/wsimport</sourceDestDir>
                            <verbose>true</verbose>
                            <keep>true</keep>
                        </configuration>
                    </execution>

                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.bookservice.client.BookClient</mainClass>
                        </manifest>
                    </archive>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                    <finalName>book-client</finalName>
                    <appendAssemblyId>false</appendAssemblyId>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
    </build>

</project>
