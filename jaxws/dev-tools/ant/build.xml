<?xml version="1.0" encoding="UTF-8"?>
<!--
╔══════════════════════════════════════════════════════════════════════════════╗
║  build.xml — ANT BUILD SCRIPT FOR MANUAL WSIMPORT + COMPILE                  ║
╠══════════════════════════════════════════════════════════════════════════════╣
║  This script is used INSIDE the dev-tools Docker container.                  ║
║  It gives you the manual workflow:                                           ║
║    1. Run wsimport manually → generates Java stubs from WSDL                 ║
║    2. Compile stubs + client code manually with javac                        ║
║    3. Run the client manually with java                                      ║
║                                                                              ║
║  HOW TO USE:                                                                 ║
║    # Connect to the dev-tools container (after docker-compose up):           ║
║    docker exec -it dev-tools bash                                            ║
║                                                                              ║
║    # Inside the container — run individual Ant targets:                      ║
║    ant wsimport-getbook       ← generate stubs from GetBook.wsdl             ║
║    ant wsimport-createbook    ← generate stubs from CreateBook.wsdl          ║
║    ant compile                ← compile everything                           ║
║    ant run                    ← run the client                               ║
║    ant all                    ← do all of the above in sequence              ║
║                                                                              ║
║  OR run ALL steps at once:                                                   ║
║    ant all                                                                   ║
║                                                                              ║
║  WHAT IS ANT?                                                                ║
║    Apache Ant is a build tool (like Maven but XML-driven, no conventions).   ║
║    Targets = tasks. Dependencies declared with depends="...".                ║
║    It was the dominant Java build tool before Maven.                         ║
║    Today it is mostly used in legacy projects or for ad-hoc scripts.         ║
╚══════════════════════════════════════════════════════════════════════════════╝
-->
<project name="book-client-manual" default="all" basedir=".">

    <!--
    ════════════════════════════════════════════════════════════════════════════
    Properties — paths used throughout the build
    ════════════════════════════════════════════════════════════════════════════
    -->
    <property name="server.host"    value="book-server"/>
    <property name="wsdl.dir"       value="/wsdl"/>
    <property name="xsd.dir"        value="/wsdl"/>
    <property name="gen.src.dir"    value="/workspace/generated-src"/>
    <property name="client.src.dir" value="/workspace/client-src"/>
    <property name="build.dir"      value="/workspace/build"/>
    <property name="dist.dir"       value="/workspace/dist"/>

    <!-- ═══ Target: init ════════════════════════════════════════════════════ -->
    <target name="init" description="Create output directories">
        <mkdir dir="${gen.src.dir}/getbook"/>
        <mkdir dir="${gen.src.dir}/createbook"/>
        <mkdir dir="${build.dir}"/>
        <mkdir dir="${dist.dir}"/>
        <echo message="Directories created."/>
    </target>

    <!-- ═══ Target: wsimport-getbook ════════════════════════════════════════ -->
    <!--
    This target invokes wsimport — a JDK tool that generates Java client stubs
    from a WSDL file.

    wsimport lives at: $JAVA_HOME/bin/wsimport  (it is part of the JDK, not JRE)

    Ant's <exec> task runs an external command.

    Arguments explained:
      -keep         → keep the generated .java source files (not just .class)
      -verbose      → print detailed output of what wsimport is doing
      -p            → the Java package name for generated classes
      -s            → directory to write generated .java SOURCE files
      -d            → directory to write compiled .class files (we ignore this)
      -wsdllocation → the WSDL location string baked into the generated code
                      (the generated Service class will reference this string)
      last arg      → the WSDL file to process
    -->
    <target name="wsimport-getbook" depends="init"
            description="Generate client stubs from GetBook.wsdl">
        <echo message="Running wsimport for GetBook.wsdl ..."/>
        <exec executable="wsimport" failonerror="true">
            <arg value="-keep"/>
            <arg value="-verbose"/>
            <arg value="-p"/>           <arg value="com.bookservice.generated.getbook"/>
            <arg value="-s"/>           <arg value="${gen.src.dir}/getbook"/>
            <arg value="-wsdllocation"/><arg value="http://${server.host}:8080/getbook?wsdl"/>
            <arg value="${wsdl.dir}/GetBook.wsdl"/>
        </exec>
        <echo message="GetBook stubs generated in: ${gen.src.dir}/getbook"/>
    </target>

    <!-- ═══ Target: wsimport-createbook ════════════════════════════════════ -->
    <target name="wsimport-createbook" depends="init"
            description="Generate client stubs from CreateBook.wsdl">
        <echo message="Running wsimport for CreateBook.wsdl ..."/>
        <exec executable="wsimport" failonerror="true">
            <arg value="-keep"/>
            <arg value="-verbose"/>
            <arg value="-p"/>           <arg value="com.bookservice.generated.createbook"/>
            <arg value="-s"/>           <arg value="${gen.src.dir}/createbook"/>
            <arg value="-wsdllocation"/><arg value="http://${server.host}:8080/createbook?wsdl"/>
            <arg value="${wsdl.dir}/CreateBook.wsdl"/>
        </exec>
        <echo message="CreateBook stubs generated in: ${gen.src.dir}/createbook"/>
    </target>

    <!-- ═══ Target: compile ═════════════════════════════════════════════════ -->
    <!--
    Compiles ALL .java files:
      1. The generated stubs from wsimport (gen.src.dir)
      2. The hand-written client code (client.src.dir)

    <javac> is Ant's Java compiler task.
      srcdir      → directories containing .java files to compile
      destdir     → where to write .class files
      source/target → Java version compatibility
      includeantruntime="false" → don't add Ant's own jars to the classpath
    -->
    <target name="compile"
            depends="wsimport-getbook, wsimport-createbook"
            description="Compile generated stubs and client code">
        <echo message="Compiling all Java sources..."/>
        <javac
            destdir="${build.dir}"
            source="1.8" target="1.8"
            includeantruntime="false">
            <src path="${gen.src.dir}/getbook"/>
            <src path="${gen.src.dir}/createbook"/>
            <src path="${client.src.dir}"/>
        </javac>
        <echo message="Compilation complete. Classes in: ${build.dir}"/>
    </target>

    <!-- ═══ Target: jar ═════════════════════════════════════════════════════ -->
    <target name="jar" depends="compile" description="Package into a runnable JAR">
        <jar destfile="${dist.dir}/book-client-manual.jar" basedir="${build.dir}">
            <manifest>
                <attribute name="Main-Class" value="com.bookservice.client.BookClient"/>
            </manifest>
        </jar>
        <echo message="JAR created: ${dist.dir}/book-client-manual.jar"/>
    </target>

    <!-- ═══ Target: run ══════════════════════════════════════════════════════ -->
    <!--
    Runs the compiled client directly from the build directory (no JAR needed).
    <java> is Ant's task for running a Java class.
      classname → the main class to run
      classpath → where to find compiled .class files
      fork="true" → run in a separate JVM process (required for proper exit)
    -->
    <target name="run" depends="compile" description="Run the SOAP client">
        <echo message="Running BookClient against http://${server.host}:8080 ..."/>
        <java classname="com.bookservice.client.BookClient" fork="true">
            <classpath>
                <pathelement location="${build.dir}"/>
            </classpath>
            <jvmarg value="-Dserver.host=${server.host}"/>
        </java>
    </target>

    <!-- ═══ Target: all ═════════════════════════════════════════════════════ -->
    <target name="all"
            depends="wsimport-getbook, wsimport-createbook, compile, run"
            description="Full pipeline: wsimport → compile → run"/>

    <!-- ═══ Target: clean ═══════════════════════════════════════════════════ -->
    <target name="clean" description="Delete all generated files">
        <delete dir="${gen.src.dir}"/>
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
        <echo message="Clean complete."/>
    </target>

</project>
